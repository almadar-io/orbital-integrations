{
  "service": "email",
  "action": "send",
  "case": "resend-send-all-options",
  "env": {
    "RESEND_API_KEY": "test-key",
    "FROM_EMAIL": "noreply@almadar.test"
  },
  "params": {
    "to": "ada@example.com",
    "subject": "Welcome",
    "body": "Hello Ada",
    "from": "billing@almadar.test",
    "htmlBody": "<p>Hello <b>Ada</b></p>",
    "replyTo": "support@almadar.test"
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "headers": {
          "content-type": "application/json",
          "accept": "*/*",
          "authorization": "<redacted>"
        },
        "body": "{\"from\":\"billing@almadar.test\",\"html\":\"<p>Hello <b>Ada</b></p>\",\"reply_to\":\"support@almadar.test\",\"subject\":\"Welcome\",\"text\":\"Hello Ada\",\"to\":\"ada@example.com\"}"
      },
      "response": {
        "status": 200,
        "body": "{\"id\":\"re-msg-2\"}"
      }
    }
  ],
  "outcome": {
    "ok": true,
    "data": {
      "id": "re-msg-2",
      "status": "sent"
    }
  }
}
