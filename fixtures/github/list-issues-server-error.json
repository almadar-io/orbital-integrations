{
  "service": "github",
  "action": "listIssues",
  "case": "list-issues-server-error",
  "env": {
    "GITHUB_TOKEN": "test-key",
    "GITHUB_OWNER": "acme",
    "GITHUB_REPO": "widgets"
  },
  "params": {
    "state": "all",
    "per_page": 5
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.github.com/repos/acme/widgets/issues?state=all&per_page=5",
        "headers": {
          "accept": "application/vnd.github+json",
          "authorization": "<redacted>"
        },
        "body": ""
      },
      "response": {
        "status": 503,
        "body": "{\"message\":\"Service Unavailable\"}"
      }
    }
  ],
  "outcome": {
    "ok": false,
    "code": "SERVICE_ERROR",
    "message": "GitHub API request failed: Service Unavailable"
  }
}
