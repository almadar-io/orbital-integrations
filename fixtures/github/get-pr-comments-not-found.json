{
  "service": "github",
  "action": "getPRComments",
  "case": "get-pr-comments-not-found",
  "env": {
    "GITHUB_TOKEN": "test-key",
    "GITHUB_OWNER": "acme",
    "GITHUB_REPO": "widgets"
  },
  "params": {
    "prNumber": 999
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.github.com/repos/acme/widgets/pulls/999/comments",
        "headers": {
          "accept": "application/vnd.github+json",
          "authorization": "<redacted>"
        },
        "body": ""
      },
      "response": {
        "status": 404,
        "body": "{\"message\":\"Not Found\"}"
      }
    }
  ],
  "outcome": {
    "ok": false,
    "code": "SERVICE_ERROR",
    "message": "GitHub API request failed: Not Found"
  }
}
