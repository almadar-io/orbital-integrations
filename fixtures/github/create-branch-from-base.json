{
  "service": "github",
  "action": "createBranch",
  "case": "create-branch-from-base",
  "env": {
    "GITHUB_TOKEN": "test-key",
    "GITHUB_WORK_DIR": "{workdir}"
  },
  "params": {
    "branchName": "feature/based",
    "baseBranch": "main"
  },
  "setup": "git-repo",
  "exchanges": [],
  "outcome": {
    "ok": true,
    "data": {
      "message": "Successfully created branch: feature/based"
    }
  }
}
