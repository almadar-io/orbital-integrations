{
  "service": "github",
  "action": "createPR",
  "case": "create-pr",
  "env": {
    "GITHUB_TOKEN": "test-key",
    "GITHUB_OWNER": "acme",
    "GITHUB_REPO": "widgets"
  },
  "params": {
    "title": "Add widgets",
    "body": "Adds the widgets.",
    "baseBranch": "main",
    "headBranch": "feature/x"
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.github.com/repos/acme/widgets/pulls",
        "headers": {
          "content-type": "text/plain;charset=UTF-8",
          "accept": "application/vnd.github+json",
          "authorization": "<redacted>"
        },
        "body": "{\"title\":\"Add widgets\",\"body\":\"Adds the widgets.\",\"base\":\"main\",\"head\":\"feature/x\",\"draft\":false}"
      },
      "response": {
        "status": 201,
        "body": "{\"number\":7,\"url\":\"https://api.github.com/repos/acme/widgets/pulls/7\",\"html_url\":\"https://github.com/acme/widgets/pull/7\",\"title\":\"Add widgets\",\"state\":\"open\",\"draft\":false,\"head\":{\"ref\":\"feature/x\"},\"base\":{\"ref\":\"main\"}}"
      }
    }
  ],
  "outcome": {
    "ok": true,
    "data": {
      "number": 7,
      "url": "https://api.github.com/repos/acme/widgets/pulls/7",
      "html_url": "https://github.com/acme/widgets/pull/7",
      "title": "Add widgets",
      "state": "open",
      "draft": false,
      "head": {
        "ref": "feature/x"
      },
      "base": {
        "ref": "main"
      }
    }
  }
}
