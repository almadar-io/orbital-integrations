{
  "service": "github",
  "action": "getFile",
  "case": "get-file-base64",
  "env": {
    "GITHUB_TOKEN": "test-key"
  },
  "params": {
    "owner": "acme",
    "repo": "widgets",
    "path": "src/index.ts"
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.github.com/repos/acme/widgets/contents/src/index.ts",
        "headers": {
          "accept": "application/vnd.github+json",
          "authorization": "<redacted>"
        },
        "body": ""
      },
      "response": {
        "status": 200,
        "body": "{\"path\":\"src/index.ts\",\"sha\":\"abc123\",\"size\":22,\"encoding\":\"base64\",\"content\":\"ZXhwb3J0IGNvbnN0IHgg\\nPSAxOwovLyBow6lsbG8=\\n\\n\"}"
      }
    }
  ],
  "outcome": {
    "ok": true,
    "data": {
      "path": "src/index.ts",
      "content": "export const x = 1;\n// héllo",
      "sha": "abc123",
      "size": 22
    }
  }
}
