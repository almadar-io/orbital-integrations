{
  "service": "database",
  "case": "statement-timeout-from-env",
  "env": {
    "DATABASE_STATEMENT_TIMEOUT_MS": "2500"
  },
  "setup": {
    "processEnv": {
      "ORDERS_DB_URL": "postgres://app:test-key@db.internal:5432/orders",
      "REPORTS_DB_URL": "postgres://reader:test-key@reports.internal:5432/reports",
      "ALIAS_DB_URL": "postgres://app:test-key@db.internal:5432/orders",
      "EMPTY_DB_URL": ""
    }
  },
  "steps": [
    {
      "action": "query",
      "params": {
        "connectionRef": "ORDERS_DB_URL",
        "sql": "SELECT 1"
      },
      "clockMs": 1760000000000,
      "randoms": [],
      "exchanges": [],
      "outcome": {
        "ok": true,
        "data": {
          "rows": [
            {
              "a": 1
            }
          ],
          "rowCount": 1
        }
      },
      "driver": {
        "connects": [
          {
            "connectionString": "postgres://app:test-key@db.internal:5432/orders",
            "statementTimeoutMs": 2500
          }
        ],
        "queries": [
          {
            "sql": "SELECT 1",
            "params": []
          }
        ]
      },
      "replies": [
        {
          "rows": [
            {
              "a": 1
            }
          ],
          "rowCount": 1
        }
      ]
    }
  ]
}
