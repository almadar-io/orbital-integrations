{
  "service": "twilio",
  "action": "sendSMS",
  "case": "send-sms-error-body-without-a-message",
  "env": {
    "TWILIO_ACCOUNT_SID": "AC00000000000000000000000000000000",
    "TWILIO_AUTH_TOKEN": "test-key",
    "TWILIO_PHONE_NUMBER": "+15005550006"
  },
  "params": {
    "to": "+4915112345678",
    "body": "hi"
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.twilio.com/2010-04-01/Accounts/AC00000000000000000000000000000000/Messages.json",
        "headers": {
          "content-type": "application/x-www-form-urlencoded",
          "accept": "application/json",
          "authorization": "<redacted>"
        },
        "body": "To=%2B4915112345678&From=%2B15005550006&Body=hi"
      },
      "response": {
        "status": 400,
        "body": "{\"code\":1}"
      }
    }
  ],
  "outcome": {
    "ok": false,
    "code": null,
    "message": ""
  }
}
