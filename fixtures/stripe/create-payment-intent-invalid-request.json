{
  "service": "stripe",
  "action": "createPaymentIntent",
  "case": "create-payment-intent-invalid-request",
  "env": {
    "STRIPE_SECRET_KEY": "test-key",
    "STRIPE_PRICE_SOLO": "price_solo_test",
    "STRIPE_PRICE_TEAMS": "price_teams_test"
  },
  "params": {
    "amount": 20,
    "currency": "usd"
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.stripe.com/v1/payment_intents",
        "headers": {
          "content-type": "application/x-www-form-urlencoded",
          "accept": "application/json",
          "authorization": "<redacted>",
          "stripe-version": "2025-02-24.acacia",
          "idempotency-key": "<generated>"
        },
        "body": "amount=20&currency=usd"
      },
      "response": {
        "status": 400,
        "body": "{\"error\":{\"type\":\"invalid_request_error\",\"code\":\"amount_too_small\",\"message\":\"Amount must be at least $0.50 usd\",\"param\":\"amount\"}}"
      }
    }
  ],
  "outcome": {
    "ok": false,
    "code": null,
    "message": "Amount must be at least $0.50 usd"
  }
}
