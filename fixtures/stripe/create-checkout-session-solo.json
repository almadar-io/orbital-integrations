{
  "service": "stripe",
  "action": "createCheckoutSession",
  "case": "create-checkout-session-solo",
  "env": {
    "STRIPE_SECRET_KEY": "test-key",
    "STRIPE_PRICE_SOLO": "price_solo_test",
    "STRIPE_PRICE_TEAMS": "price_teams_test"
  },
  "params": {
    "tier": "solo",
    "quantity": 1,
    "successUrl": "https://app.example.com/billing/success",
    "cancelUrl": "https://app.example.com/billing/cancel",
    "customerId": "cus_1"
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.stripe.com/v1/checkout/sessions",
        "headers": {
          "content-type": "application/x-www-form-urlencoded",
          "accept": "application/json",
          "authorization": "<redacted>",
          "stripe-version": "2025-02-24.acacia",
          "idempotency-key": "<generated>"
        },
        "body": "mode=subscription&customer=cus_1&line_items[0][price]=price_solo_test&line_items[0][quantity]=1&success_url=https%3A%2F%2Fapp.example.com%2Fbilling%2Fsuccess&cancel_url=https%3A%2F%2Fapp.example.com%2Fbilling%2Fcancel&automatic_tax[enabled]=true&allow_promotion_codes=true"
      },
      "response": {
        "status": 200,
        "body": "{\"id\":\"cs_1\",\"object\":\"checkout.session\",\"url\":\"https://checkout.stripe.com/c/pay/cs_1\",\"customer\":\"cus_1\"}"
      }
    }
  ],
  "outcome": {
    "ok": true,
    "data": {
      "url": "https://checkout.stripe.com/c/pay/cs_1",
      "sessionId": "cs_1",
      "customerId": "cus_1"
    }
  }
}
