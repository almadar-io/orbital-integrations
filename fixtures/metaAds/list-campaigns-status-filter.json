{
  "service": "metaAds",
  "action": "listCampaigns",
  "case": "list-campaigns-status-filter",
  "env": {
    "META_ACCESS_TOKEN": "test-key",
    "META_AD_ACCOUNT_ID": "1234567890"
  },
  "params": {
    "status": "ACTIVE",
    "accountId": "act_9"
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://graph.facebook.com/v21.0/act_9/campaigns?fields=id%2Cname%2Cstatus%2Cdaily_budget&effective_status=%5B%22ACTIVE%22%5D&access_token=test-key",
        "headers": {
          "accept": "*/*"
        },
        "body": ""
      },
      "response": {
        "status": 200,
        "body": "{\"data\":[{\"id\":\"1\",\"name\":\"Spring sale\",\"status\":\"ACTIVE\",\"daily_budget\":\"2500\"}]}"
      }
    }
  ],
  "outcome": {
    "ok": true,
    "data": {
      "campaigns": [
        {
          "id": "1",
          "name": "Spring sale",
          "status": "ACTIVE",
          "dailyBudget": 25
        }
      ]
    }
  }
}
