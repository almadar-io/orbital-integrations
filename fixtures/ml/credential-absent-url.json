{
  "service": "ml",
  "action": "infer",
  "case": "credential-absent-url",
  "env": {
    "MASAR_ML_TRAIT": "inference-serving"
  },
  "params": {
    "model": "hf:distilbert-base-uncased",
    "input": {
      "tokens": [
        101,
        2023,
        102
      ],
      "mask": [
        1,
        1,
        1
      ]
    }
  },
  "exchanges": [],
  "outcome": {
    "ok": false,
    "code": null,
    "message": "ML integration requires MASAR_URL (serving orbital host) and MASAR_ML_TRAIT (kebab-case trait name of its /events route) to be configured"
  }
}
