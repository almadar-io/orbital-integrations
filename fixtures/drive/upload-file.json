{
  "service": "drive",
  "action": "uploadFile",
  "case": "upload-file",
  "env": {
    "GOOGLE_DRIVE_REFRESH_TOKEN": "test-refresh-token",
    "OAUTH_CLIENT_ID": "test-client-id",
    "OAUTH_CLIENT_SECRET": "test-client-secret"
  },
  "params": {
    "name": "notes.txt",
    "content": "hello"
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://oauth2.googleapis.com/token",
        "headers": {
          "content-type": "application/x-www-form-urlencoded",
          "accept": "*/*"
        },
        "body": "refresh_token=test-refresh-token&client_id=test-client-id&client_secret=test-client-secret&grant_type=refresh_token"
      },
      "response": {
        "status": 200,
        "body": "{\"access_token\":\"ya29.test-token\",\"expires_in\":3599,\"token_type\":\"Bearer\"}"
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://www.googleapis.com/upload/drive/v3/files?fields=id%2C%20name%2C%20webViewLink&uploadType=multipart",
        "headers": {
          "content-type": "multipart/related; boundary={boundary}",
          "accept": "*/*",
          "authorization": "<redacted>"
        },
        "body": "--{boundary}\r\ncontent-type: application/json\r\n\r\n{\"name\":\"notes.txt\"}\r\n--{boundary}\r\ncontent-type: application/octet-stream\r\n\r\nhello\r\n--{boundary}--"
      },
      "response": {
        "status": 200,
        "body": "{\"id\":\"f1\",\"name\":\"notes.txt\",\"webViewLink\":\"https://drive.google.com/file/d/f1/view\"}"
      }
    }
  ],
  "outcome": {
    "ok": true,
    "data": {
      "id": "f1",
      "name": "notes.txt",
      "webViewLink": "https://drive.google.com/file/d/f1/view"
    }
  }
}
