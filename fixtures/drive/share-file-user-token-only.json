{
  "service": "drive",
  "action": "shareFile",
  "case": "share-file-user-token-only",
  "env": {
    "GOOGLE_DRIVE_REFRESH_TOKEN": "test-refresh-token",
    "OAUTH_CLIENT_ID": "test-client-id",
    "OAUTH_CLIENT_SECRET": "test-client-secret"
  },
  "params": {
    "fileId": "f1",
    "email": "ada@example.com"
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://oauth2.googleapis.com/token",
        "headers": {
          "content-type": "application/x-www-form-urlencoded",
          "accept": "*/*"
        },
        "body": "refresh_token=test-refresh-token&client_id=test-client-id&client_secret=test-client-secret&grant_type=refresh_token"
      },
      "response": {
        "status": 200,
        "body": "{\"access_token\":\"ya29.test-token\",\"expires_in\":3599,\"token_type\":\"Bearer\"}"
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://www.googleapis.com/drive/v3/files/f1/permissions?fields=id",
        "headers": {
          "content-type": "application/json",
          "accept": "*/*",
          "authorization": "<redacted>"
        },
        "body": "{\"type\":\"user\",\"role\":\"reader\",\"emailAddress\":\"ada@example.com\"}"
      },
      "response": {
        "status": 200,
        "body": "{\"id\":\"perm3\"}"
      }
    }
  ],
  "outcome": {
    "ok": true,
    "data": {
      "shared": true,
      "permissionId": "perm3"
    }
  }
}
