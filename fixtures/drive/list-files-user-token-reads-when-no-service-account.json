{
  "service": "drive",
  "action": "listFiles",
  "case": "list-files-user-token-reads-when-no-service-account",
  "env": {
    "GOOGLE_DRIVE_REFRESH_TOKEN": "test-refresh-token",
    "OAUTH_CLIENT_ID": "test-client-id",
    "OAUTH_CLIENT_SECRET": "test-client-secret"
  },
  "params": {},
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://oauth2.googleapis.com/token",
        "headers": {
          "content-type": "application/x-www-form-urlencoded",
          "accept": "*/*"
        },
        "body": "refresh_token=test-refresh-token&client_id=test-client-id&client_secret=test-client-secret&grant_type=refresh_token"
      },
      "response": {
        "status": 200,
        "body": "{\"access_token\":\"ya29.test-token\",\"expires_in\":3599,\"token_type\":\"Bearer\"}"
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://www.googleapis.com/drive/v3/files?q=trashed%20%3D%20false&pageSize=100&fields=files%28id%2C%20name%2C%20mimeType%2C%20size%2C%20modifiedTime%2C%20webViewLink%29",
        "headers": {
          "accept": "*/*",
          "authorization": "<redacted>"
        },
        "body": ""
      },
      "response": {
        "status": 200,
        "body": "{\"files\":[]}"
      }
    }
  ],
  "outcome": {
    "ok": true,
    "data": {
      "files": []
    }
  }
}
