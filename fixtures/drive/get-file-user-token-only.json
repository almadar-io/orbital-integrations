{
  "service": "drive",
  "action": "getFile",
  "case": "get-file-user-token-only",
  "env": {
    "GOOGLE_DRIVE_REFRESH_TOKEN": "test-refresh-token",
    "OAUTH_CLIENT_ID": "test-client-id",
    "OAUTH_CLIENT_SECRET": "test-client-secret"
  },
  "params": {
    "fileId": "f1"
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://oauth2.googleapis.com/token",
        "headers": {
          "content-type": "application/x-www-form-urlencoded",
          "accept": "*/*"
        },
        "body": "refresh_token=test-refresh-token&client_id=test-client-id&client_secret=test-client-secret&grant_type=refresh_token"
      },
      "response": {
        "status": 200,
        "body": "{\"access_token\":\"ya29.test-token\",\"expires_in\":3599,\"token_type\":\"Bearer\"}"
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://www.googleapis.com/drive/v3/files/f1?fields=id%2C%20name%2C%20mimeType%2C%20size",
        "headers": {
          "accept": "*/*",
          "authorization": "<redacted>"
        },
        "body": ""
      },
      "response": {
        "status": 200,
        "body": "{\"id\":\"f1\",\"name\":\"n\",\"mimeType\":\"text/plain\"}"
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://www.googleapis.com/drive/v3/files/f1?alt=media",
        "headers": {
          "accept": "*/*",
          "authorization": "<redacted>"
        },
        "body": ""
      },
      "response": {
        "status": 200,
        "body": "hi"
      }
    }
  ],
  "outcome": {
    "ok": true,
    "data": {
      "id": "f1",
      "name": "n",
      "mimeType": "text/plain",
      "content": "aGk=",
      "size": 2
    }
  }
}
