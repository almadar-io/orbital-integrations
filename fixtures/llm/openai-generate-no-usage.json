{
  "service": "llm",
  "action": "generate",
  "case": "openai-generate-no-usage",
  "env": {
    "OPENAI_API_KEY": "test-key",
    "OPENAI_BASE_URL": "{base}/v1"
  },
  "params": {
    "userPrompt": "hi"
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "{base}/v1/chat/completions",
        "headers": {
          "content-type": "application/json",
          "accept": "application/json",
          "authorization": "<redacted>"
        },
        "body": "{\"model\":\"gpt-4o\",\"temperature\":0.7,\"stream\":false,\"max_tokens\":1024,\"messages\":[{\"role\":\"system\",\"content\":\"You are a helpful assistant.\"},{\"role\":\"user\",\"content\":\"hi\"}]}"
      },
      "response": {
        "status": 200,
        "body": "{\"id\":\"c\",\"object\":\"chat.completion\",\"created\":1,\"model\":\"gpt-4o\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"hi\"},\"finish_reason\":\"stop\"}]}"
      }
    }
  ],
  "outcome": {
    "ok": true,
    "data": {
      "content": "hi",
      "usage": {
        "promptTokens": 0,
        "completionTokens": 0,
        "totalTokens": 0
      }
    }
  }
}
