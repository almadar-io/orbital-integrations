{
  "service": "llm",
  "action": "embed",
  "case": "openrouter-embed-default",
  "env": {
    "OPEN_ROUTER_API_KEY": "test-key",
    "EMBEDDING_API_KEY": "test-key"
  },
  "params": {
    "texts": [
      "alpha"
    ]
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/embeddings",
        "headers": {
          "content-type": "application/json",
          "accept": "*/*",
          "authorization": "<redacted>"
        },
        "body": "{\"model\":\"baai/bge-base-en-v1.5\",\"input\":[\"alpha\"]}"
      },
      "response": {
        "status": 200,
        "body": "{\"object\":\"list\",\"data\":[{\"object\":\"embedding\",\"index\":0,\"embedding\":[0.5,0.25]}],\"model\":\"m\",\"usage\":{\"prompt_tokens\":5,\"total_tokens\":5}}"
      }
    }
  ],
  "outcome": {
    "ok": true,
    "data": {
      "embeddings": [
        [
          0.5,
          0.25
        ]
      ]
    }
  }
}
