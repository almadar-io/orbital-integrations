{
  "service": "llm",
  "action": "classify",
  "case": "openai-classify",
  "env": {
    "OPENAI_API_KEY": "test-key",
    "OPENAI_BASE_URL": "{base}/v1"
  },
  "params": {
    "text": "The invoice is overdue",
    "categories": [
      "billing",
      "support"
    ]
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "{base}/v1/chat/completions",
        "headers": {
          "content-type": "application/json",
          "accept": "application/json",
          "authorization": "<redacted>"
        },
        "body": "{\"model\":\"gpt-4o\",\"temperature\":0.1,\"stream\":false,\"messages\":[{\"role\":\"system\",\"content\":\"You are a text classifier. Classify the given text into one of these categories: billing, support. Return JSON with: category, confidence (0-1), and reasoning.\"},{\"role\":\"user\",\"content\":\"The invoice is overdue\"}]}"
      },
      "response": {
        "status": 200,
        "body": "{\"id\":\"chatcmpl-1\",\"object\":\"chat.completion\",\"created\":1,\"model\":\"gpt-4o\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"{\\\"category\\\":\\\"billing\\\",\\\"confidence\\\":0.9,\\\"reasoning\\\":\\\"mentions an invoice\\\"}\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":3,\"completion_tokens\":1,\"total_tokens\":4}}"
      }
    }
  ],
  "outcome": {
    "ok": true,
    "data": {
      "category": "billing",
      "confidence": 0.9,
      "reasoning": "mentions an invoice"
    }
  }
}
