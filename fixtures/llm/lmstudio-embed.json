{
  "service": "llm",
  "action": "embed",
  "case": "lmstudio-embed",
  "env": {
    "OPENAI_API_KEY": "test-key",
    "EMBEDDING_PROVIDER": "lmstudio",
    "LMSTUDIO_URL": "{base}/v1"
  },
  "params": {
    "texts": [
      "alpha",
      "beta"
    ]
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "{base}/v1/embeddings",
        "headers": {
          "content-type": "application/json",
          "accept": "*/*",
          "authorization": "<redacted>"
        },
        "body": "{\"model\":\"baai/bge-base-en-v1.5\",\"input\":[\"alpha\",\"beta\"]}"
      },
      "response": {
        "status": 200,
        "body": "{\"object\":\"list\",\"data\":[{\"object\":\"embedding\",\"index\":0,\"embedding\":[0.1,0.2]},{\"object\":\"embedding\",\"index\":1,\"embedding\":[0.3,0.4]}],\"model\":\"m\",\"usage\":{\"prompt_tokens\":5,\"total_tokens\":5}}"
      }
    }
  ],
  "outcome": {
    "ok": true,
    "data": {
      "embeddings": [
        [
          0.1,
          0.2
        ],
        [
          0.3,
          0.4
        ]
      ]
    }
  }
}
