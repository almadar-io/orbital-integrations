{
  "service": "llm",
  "action": "generate",
  "case": "openai-generate",
  "env": {
    "OPENAI_API_KEY": "test-key",
    "OPENAI_BASE_URL": "{base}/v1"
  },
  "params": {
    "userPrompt": "Reply with OK."
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "{base}/v1/chat/completions",
        "headers": {
          "content-type": "application/json",
          "accept": "application/json",
          "authorization": "<redacted>"
        },
        "body": "{\"model\":\"gpt-4o\",\"temperature\":0.7,\"stream\":false,\"max_tokens\":1024,\"messages\":[{\"role\":\"system\",\"content\":\"You are a helpful assistant.\"},{\"role\":\"user\",\"content\":\"Reply with OK.\"}]}"
      },
      "response": {
        "status": 200,
        "body": "{\"id\":\"chatcmpl-1\",\"object\":\"chat.completion\",\"created\":1,\"model\":\"gpt-4o\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"OK\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":3,\"completion_tokens\":1,\"total_tokens\":4}}"
      }
    }
  ],
  "outcome": {
    "ok": true,
    "data": {
      "content": "OK",
      "usage": {
        "promptTokens": 3,
        "completionTokens": 1,
        "totalTokens": 4
      }
    }
  }
}
