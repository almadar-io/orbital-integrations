{
  "service": "llm",
  "action": "generate",
  "case": "openai-generate-unauthorized",
  "env": {
    "OPENAI_API_KEY": "test-key",
    "OPENAI_BASE_URL": "{base}/v1"
  },
  "params": {
    "userPrompt": "hi"
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "{base}/v1/chat/completions",
        "headers": {
          "content-type": "application/json",
          "accept": "application/json",
          "authorization": "<redacted>"
        },
        "body": "{\"model\":\"gpt-4o\",\"temperature\":0.7,\"stream\":false,\"max_tokens\":1024,\"messages\":[{\"role\":\"system\",\"content\":\"You are a helpful assistant.\"},{\"role\":\"user\",\"content\":\"hi\"}]}"
      },
      "response": {
        "status": 401,
        "body": "{\"error\":{\"message\":\"Incorrect API key provided\",\"type\":\"invalid_request_error\",\"code\":\"invalid_api_key\"}}"
      }
    }
  ],
  "outcome": {
    "ok": false,
    "code": null,
    "message": "401 Incorrect API key provided\n\nTroubleshooting URL: https://docs.langchain.com/oss/javascript/langchain/errors/MODEL_AUTHENTICATION/\n"
  }
}
