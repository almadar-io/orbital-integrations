{
  "service": "oauth",
  "case": "real-authorize-discovery-issuer-mismatch",
  "nowMs": 1800000000000,
  "env": {
    "OAUTH_CLIENT_ID": "client-id-1",
    "OAUTH_CLIENT_SECRET": "test-key",
    "OAUTH_REDIRECT_URI": "https://app.example.com/default-callback"
  },
  "steps": [
    {
      "action": "authorize",
      "params": {
        "provider": "google",
        "scopes": [
          "openid",
          "email"
        ],
        "redirectUri": "https://app.example.com/callback"
      },
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "url": "https://accounts.google.com/.well-known/openid-configuration",
            "headers": {
              "accept": "application/json"
            },
            "body": ""
          },
          "response": {
            "status": 200,
            "body": "{\"issuer\":\"https://evil.example.com\",\"authorization_endpoint\":\"https://accounts.google.com/o/oauth2/v2/auth\",\"token_endpoint\":\"https://oauth2.googleapis.com/token\",\"userinfo_endpoint\":\"https://openidconnect.googleapis.com/v1/userinfo\",\"revocation_endpoint\":\"https://oauth2.googleapis.com/revoke\",\"jwks_uri\":\"https://www.googleapis.com/oauth2/v3/certs\",\"id_token_signing_alg_values_supported\":[\"RS256\"]}"
          }
        }
      ],
      "outcome": {
        "ok": false,
        "code": null,
        "message": "discovered metadata issuer does not match the expected issuer"
      }
    }
  ]
}
