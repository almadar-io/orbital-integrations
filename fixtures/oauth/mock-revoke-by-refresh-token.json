{
  "service": "oauth",
  "case": "mock-revoke-by-refresh-token",
  "nowMs": 1800000000000,
  "env": {
    "OAUTH_MODE": "mock"
  },
  "steps": [
    {
      "action": "authorize",
      "params": {
        "provider": "github",
        "scopes": [
          "openid",
          "email"
        ],
        "redirectUri": "https://app.example.com/callback"
      },
      "exchanges": [],
      "outcome": {
        "ok": true,
        "data": {
          "authUrl": "https://github.com/login/oauth/authorize?response_type=code&scope=openid+email&redirect_uri=https%3A%2F%2Fapp.example.com%2Fcallback&state=<hex32>&client_id=mock-client-id",
          "state": "<hex32>"
        }
      }
    },
    {
      "action": "token",
      "params": {
        "code": "auth-code-123",
        "state": "{{0.state}}"
      },
      "exchanges": [],
      "outcome": {
        "ok": true,
        "data": {
          "accessToken": "<hex64>",
          "refreshToken": "<hex64>",
          "expiresIn": 3600,
          "tokenType": "bearer",
          "scope": [
            "openid",
            "email"
          ]
        }
      }
    },
    {
      "action": "revoke",
      "params": {
        "token": "{{1.refreshToken}}"
      },
      "exchanges": [],
      "outcome": {
        "ok": true,
        "data": {
          "revoked": true
        }
      }
    },
    {
      "action": "userinfo",
      "params": {
        "accessToken": "{{1.accessToken}}"
      },
      "exchanges": [],
      "outcome": {
        "ok": false,
        "code": null,
        "message": "Invalid access token"
      }
    },
    {
      "action": "refresh",
      "params": {
        "refreshToken": "{{1.refreshToken}}"
      },
      "exchanges": [],
      "outcome": {
        "ok": false,
        "code": null,
        "message": "Invalid refresh token"
      }
    }
  ]
}
