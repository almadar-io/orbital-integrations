{
  "service": "oauth",
  "case": "real-authorize-discovery-without-endpoint",
  "nowMs": 1800000000000,
  "env": {
    "OAUTH_CLIENT_ID": "client-id-1",
    "OAUTH_CLIENT_SECRET": "test-key",
    "OAUTH_REDIRECT_URI": "https://app.example.com/default-callback"
  },
  "steps": [
    {
      "action": "authorize",
      "params": {
        "provider": "google",
        "scopes": [
          "openid",
          "email"
        ],
        "redirectUri": "https://app.example.com/callback"
      },
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "url": "https://accounts.google.com/.well-known/openid-configuration",
            "headers": {
              "accept": "application/json"
            },
            "body": ""
          },
          "response": {
            "status": 200,
            "body": "{\"issuer\":\"https://accounts.google.com\"}"
          }
        }
      ],
      "outcome": {
        "ok": false,
        "code": null,
        "message": "authorization server metadata does not contain a valid \"as.authorization_endpoint\""
      }
    }
  ]
}
