{
  "service": "oauth",
  "case": "real-flow-google",
  "nowMs": 1800000000000,
  "env": {
    "OAUTH_CLIENT_ID": "client-id-1",
    "OAUTH_CLIENT_SECRET": "test-key",
    "OAUTH_REDIRECT_URI": "https://app.example.com/default-callback"
  },
  "steps": [
    {
      "action": "authorize",
      "params": {
        "provider": "google",
        "scopes": [
          "openid",
          "email"
        ],
        "redirectUri": "https://app.example.com/callback",
        "subject": "user-1"
      },
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "url": "https://accounts.google.com/.well-known/openid-configuration",
            "headers": {
              "accept": "application/json"
            },
            "body": ""
          },
          "response": {
            "status": 200,
            "body": "{\"issuer\":\"https://accounts.google.com\",\"authorization_endpoint\":\"https://accounts.google.com/o/oauth2/v2/auth\",\"token_endpoint\":\"https://oauth2.googleapis.com/token\",\"userinfo_endpoint\":\"https://openidconnect.googleapis.com/v1/userinfo\",\"revocation_endpoint\":\"https://oauth2.googleapis.com/revoke\",\"jwks_uri\":\"https://www.googleapis.com/oauth2/v3/certs\",\"id_token_signing_alg_values_supported\":[\"RS256\"]}"
          }
        }
      ],
      "outcome": {
        "ok": true,
        "data": {
          "authUrl": "https://accounts.google.com/o/oauth2/v2/auth?access_type=offline&prompt=consent&redirect_uri=https%3A%2F%2Fapp.example.com%2Fcallback&scope=openid+email&state=<state>&code_challenge=<code_challenge>&code_challenge_method=S256&client_id=client-id-1&response_type=code",
          "state": "<state>"
        }
      }
    },
    {
      "action": "token",
      "params": {
        "code": "auth-code-123",
        "state": "{{0.state}}",
        "subject": "user-1"
      },
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "url": "https://oauth2.googleapis.com/token",
            "headers": {
              "content-type": "application/x-www-form-urlencoded;charset=UTF-8",
              "accept": "application/json"
            },
            "body": "redirect_uri=https%3A%2F%2Fapp.example.com%2Fcallback&code=auth-code-123&code_verifier=<code_verifier>&grant_type=authorization_code&client_id=client-id-1&client_secret=test-key"
          },
          "response": {
            "status": 200,
            "body": "{\"access_token\":\"at-1\",\"token_type\":\"Bearer\",\"expires_in\":3599,\"refresh_token\":\"rt-1\",\"scope\":\"openid email\",\"id_token\":\"eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJodHRwczovL2FjY291bnRzLmdvb2dsZS5jb20iLCJhdWQiOiJjbGllbnQtaWQtMSIsImV4cCI6NDEwMjQ0NDgwMCwiaWF0IjoxNzAwMDAwMDAwLCJzdWIiOiJzdWItMSIsImVtYWlsIjoiYWRhQGV4YW1wbGUuY29tIn0.c2lnbmF0dXJl\"}"
          }
        }
      ],
      "outcome": {
        "ok": true,
        "data": {
          "accessToken": "at-1",
          "refreshToken": "rt-1",
          "expiresIn": 3599,
          "tokenType": "bearer",
          "scope": [
            "openid",
            "email"
          ],
          "subject": "user-1"
        }
      }
    },
    {
      "action": "userinfo",
      "params": {
        "accessToken": "{{1.accessToken}}"
      },
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "url": "https://openidconnect.googleapis.com/v1/userinfo",
            "headers": {
              "accept": "application/json, application/jwt",
              "authorization": "<redacted>"
            },
            "body": ""
          },
          "response": {
            "status": 200,
            "body": "{\"sub\":\"sub-1\",\"email\":\"ada@example.com\",\"name\":\"Ada\",\"picture\":\"https://example.com/ada.png\"}"
          }
        }
      ],
      "outcome": {
        "ok": true,
        "data": {
          "sub": "sub-1",
          "email": "ada@example.com",
          "name": "Ada",
          "picture": "https://example.com/ada.png"
        }
      }
    },
    {
      "action": "refresh",
      "params": {
        "refreshToken": "{{1.refreshToken}}"
      },
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "url": "https://oauth2.googleapis.com/token",
            "headers": {
              "content-type": "application/x-www-form-urlencoded;charset=UTF-8",
              "accept": "application/json"
            },
            "body": "refresh_token=rt-1&grant_type=refresh_token&client_id=client-id-1&client_secret=test-key"
          },
          "response": {
            "status": 200,
            "body": "{\"access_token\":\"at-2\",\"token_type\":\"Bearer\",\"expires_in\":3599,\"scope\":\"openid email\",\"id_token\":\"eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJodHRwczovL2FjY291bnRzLmdvb2dsZS5jb20iLCJhdWQiOiJjbGllbnQtaWQtMSIsImV4cCI6NDEwMjQ0NDgwMCwiaWF0IjoxNzAwMDAwMDAwLCJzdWIiOiJzdWItMSJ9.c2lnbmF0dXJl\"}"
          }
        }
      ],
      "outcome": {
        "ok": true,
        "data": {
          "accessToken": "at-2",
          "expiresIn": 3599
        }
      }
    },
    {
      "action": "userinfo",
      "params": {
        "accessToken": "{{3.accessToken}}"
      },
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "url": "https://openidconnect.googleapis.com/v1/userinfo",
            "headers": {
              "accept": "application/json, application/jwt",
              "authorization": "<redacted>"
            },
            "body": ""
          },
          "response": {
            "status": 200,
            "body": "{\"sub\":\"sub-1\",\"email\":\"ada@example.com\"}"
          }
        }
      ],
      "outcome": {
        "ok": true,
        "data": {
          "sub": "sub-1",
          "email": "ada@example.com",
          "name": "",
          "picture": ""
        }
      }
    },
    {
      "action": "revoke",
      "params": {
        "token": "{{3.accessToken}}"
      },
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "url": "https://oauth2.googleapis.com/revoke",
            "headers": {
              "content-type": "application/x-www-form-urlencoded;charset=UTF-8",
              "accept": "*/*"
            },
            "body": "token=at-2&client_id=client-id-1&client_secret=test-key"
          },
          "response": {
            "status": 200,
            "body": ""
          }
        }
      ],
      "outcome": {
        "ok": true,
        "data": {
          "revoked": true
        }
      }
    },
    {
      "action": "userinfo",
      "params": {
        "accessToken": "{{3.accessToken}}"
      },
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "url": "https://openidconnect.googleapis.com/v1/userinfo",
            "headers": {
              "accept": "application/json, application/jwt",
              "authorization": "<redacted>"
            },
            "body": ""
          },
          "response": {
            "status": 200,
            "body": "{\"sub\":\"sub-9\"}"
          }
        }
      ],
      "outcome": {
        "ok": true,
        "data": {
          "sub": "sub-9",
          "email": "",
          "name": "",
          "picture": ""
        }
      }
    }
  ]
}
