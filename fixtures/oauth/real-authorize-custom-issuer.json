{
  "service": "oauth",
  "case": "real-authorize-custom-issuer",
  "nowMs": 1800000000000,
  "env": {
    "OAUTH_CLIENT_ID": "client-id-1",
    "OAUTH_CLIENT_SECRET": "test-key",
    "OAUTH_REDIRECT_URI": "https://app.example.com/default-callback",
    "OIDC_ISSUER_URL": "https://idp.example.com/tenant"
  },
  "steps": [
    {
      "action": "authorize",
      "params": {
        "provider": "auth0",
        "scopes": [
          "openid",
          "email"
        ],
        "redirectUri": "https://app.example.com/callback"
      },
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "url": "https://idp.example.com/tenant/.well-known/openid-configuration",
            "headers": {
              "accept": "application/json"
            },
            "body": ""
          },
          "response": {
            "status": 200,
            "body": "{\"issuer\":\"https://idp.example.com/tenant\",\"authorization_endpoint\":\"https://idp.example.com/tenant/authorize\",\"token_endpoint\":\"https://idp.example.com/tenant/oauth/token\",\"userinfo_endpoint\":\"https://openidconnect.googleapis.com/v1/userinfo\",\"revocation_endpoint\":\"https://oauth2.googleapis.com/revoke\",\"jwks_uri\":\"https://www.googleapis.com/oauth2/v3/certs\",\"id_token_signing_alg_values_supported\":[\"RS256\"]}"
          }
        }
      ],
      "outcome": {
        "ok": true,
        "data": {
          "authUrl": "https://idp.example.com/tenant/authorize?redirect_uri=https%3A%2F%2Fapp.example.com%2Fcallback&scope=openid+email&state=<state>&code_challenge=<code_challenge>&code_challenge_method=S256&client_id=client-id-1&response_type=code",
          "state": "<state>"
        }
      }
    }
  ]
}
