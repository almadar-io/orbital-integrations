{
  "service": "oauth",
  "case": "mock-token-subject-bound",
  "nowMs": 1800000000000,
  "env": {
    "OAUTH_MODE": "mock"
  },
  "steps": [
    {
      "action": "authorize",
      "params": {
        "provider": "google",
        "scopes": [
          "openid",
          "email"
        ],
        "redirectUri": "https://app.example.com/callback",
        "subject": "user-1"
      },
      "exchanges": [],
      "outcome": {
        "ok": true,
        "data": {
          "authUrl": "https://accounts.google.com/o/oauth2/v2/auth?response_type=code&scope=openid+email&redirect_uri=https%3A%2F%2Fapp.example.com%2Fcallback&state=<hex32>&client_id=mock-client-id",
          "state": "<hex32>"
        }
      }
    },
    {
      "action": "token",
      "params": {
        "code": "auth-code-123",
        "state": "{{0.state}}",
        "subject": "user-1"
      },
      "exchanges": [],
      "outcome": {
        "ok": true,
        "data": {
          "accessToken": "<hex64>",
          "refreshToken": "<hex64>",
          "expiresIn": 3600,
          "tokenType": "bearer",
          "scope": [
            "openid",
            "email"
          ],
          "subject": "user-1"
        }
      }
    }
  ]
}
