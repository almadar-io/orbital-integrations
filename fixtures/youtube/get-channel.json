{
  "service": "youtube",
  "action": "getChannel",
  "case": "get-channel",
  "env": {
    "YOUTUBE_API_KEY": "test-key"
  },
  "params": {
    "channelId": "chan1"
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://youtube.googleapis.com/youtube/v3/channels?part=snippet&part=statistics&id=chan1&key=test-key",
        "headers": {
          "accept": "*/*"
        },
        "body": ""
      },
      "response": {
        "status": 200,
        "body": "{\"kind\":\"youtube#channelListResponse\",\"items\":[{\"kind\":\"youtube#channel\",\"id\":\"chan1\",\"snippet\":{\"title\":\"Almadar\",\"description\":\"Builds apps\"},\"statistics\":{\"subscriberCount\":\"12345\",\"viewCount\":\"999\"}}]}"
      }
    }
  ],
  "outcome": {
    "ok": true,
    "data": {
      "name": "Almadar",
      "description": "Builds apps",
      "subscriberCount": "12345"
    }
  }
}
