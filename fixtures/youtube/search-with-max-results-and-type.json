{
  "service": "youtube",
  "action": "search",
  "case": "search-with-max-results-and-type",
  "env": {
    "YOUTUBE_API_KEY": "test-key"
  },
  "params": {
    "query": "café & crème",
    "maxResults": 5,
    "type": "video"
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://youtube.googleapis.com/youtube/v3/search?part=snippet&q=caf%C3%A9%20%26%20cr%C3%A8me&maxResults=5&type=video&key=test-key",
        "headers": {
          "accept": "*/*"
        },
        "body": ""
      },
      "response": {
        "status": 200,
        "body": "{\"items\":[{\"kind\":\"youtube#searchResult\",\"id\":{\"kind\":\"youtube#video\",\"videoId\":\"abc123\"},\"snippet\":{\"title\":\"One\",\"description\":\"About One\",\"thumbnails\":{\"default\":{\"url\":\"https://i.ytimg.com/vi/abc123/default.jpg\",\"width\":120,\"height\":90}}}}]}"
      }
    }
  ],
  "outcome": {
    "ok": true,
    "data": [
      {
        "videoId": "abc123",
        "title": "One",
        "thumbnail": "https://i.ytimg.com/vi/abc123/default.jpg",
        "description": "About One"
      }
    ]
  }
}
