{
  "service": "youtube",
  "action": "search",
  "case": "search-retries-rate-limiting-then-succeeds",
  "env": {
    "YOUTUBE_API_KEY": "test-key"
  },
  "params": {
    "query": "x"
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://youtube.googleapis.com/youtube/v3/search?part=snippet&q=x&maxResults=10&key=test-key",
        "headers": {
          "accept": "*/*"
        },
        "body": ""
      },
      "response": {
        "status": 429,
        "body": "{\"error\":{\"code\":429,\"message\":\"Too many requests.\",\"errors\":[{\"message\":\"Too many requests.\",\"domain\":\"youtube.quota\",\"reason\":\"rateLimitExceeded\"}],\"status\":\"ERROR\"}}"
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://youtube.googleapis.com/youtube/v3/search?part=snippet&q=x&maxResults=10&key=test-key",
        "headers": {
          "accept": "*/*"
        },
        "body": ""
      },
      "response": {
        "status": 429,
        "body": "{\"error\":{\"code\":429,\"message\":\"Too many requests.\",\"errors\":[{\"message\":\"Too many requests.\",\"domain\":\"youtube.quota\",\"reason\":\"rateLimitExceeded\"}],\"status\":\"ERROR\"}}"
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://youtube.googleapis.com/youtube/v3/search?part=snippet&q=x&maxResults=10&key=test-key",
        "headers": {
          "accept": "*/*"
        },
        "body": ""
      },
      "response": {
        "status": 200,
        "body": "{\"items\":[]}"
      }
    }
  ],
  "outcome": {
    "ok": true,
    "data": []
  }
}
