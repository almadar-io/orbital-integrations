{
  "service": "youtube",
  "action": "search",
  "case": "search-retries-a-server-error-then-succeeds",
  "env": {
    "YOUTUBE_API_KEY": "test-key"
  },
  "params": {
    "query": "x"
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://youtube.googleapis.com/youtube/v3/search?part=snippet&q=x&maxResults=10&key=test-key",
        "headers": {
          "accept": "*/*"
        },
        "body": ""
      },
      "response": {
        "status": 502,
        "body": "bad gateway",
        "headers": {
          "content-type": "text/plain"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://youtube.googleapis.com/youtube/v3/search?part=snippet&q=x&maxResults=10&key=test-key",
        "headers": {
          "accept": "*/*"
        },
        "body": ""
      },
      "response": {
        "status": 200,
        "body": "{\"items\":[{\"kind\":\"youtube#searchResult\",\"id\":{\"kind\":\"youtube#video\",\"videoId\":\"abc123\"},\"snippet\":{\"title\":\"Second try\",\"description\":\"About Second try\",\"thumbnails\":{\"default\":{\"url\":\"https://i.ytimg.com/vi/abc123/default.jpg\",\"width\":120,\"height\":90}}}}]}"
      }
    }
  ],
  "outcome": {
    "ok": true,
    "data": [
      {
        "videoId": "abc123",
        "title": "Second try",
        "thumbnail": "https://i.ytimg.com/vi/abc123/default.jpg",
        "description": "About Second try"
      }
    ]
  }
}
