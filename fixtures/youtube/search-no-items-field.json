      "response": {
        "status": 200,
        "body": "{\"kind\":\"youtube#searchListResponse\",\"pageInfo\":{\"totalResults\":0}}"
      }
    }
  ],
  "outcome": {
    "ok": true,
    "data": null
  }
}
