{
  "service": "youtube",
  "action": "search",
  "case": "search-no-items-field",
  "env": {
    "YOUTUBE_API_KEY": "test-key"
  },
  "params": {
    "query": "nothing"
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://youtube.googleapis.com/youtube/v3/search?part=snippet&q=nothing&maxResults=10&key=test-key",
        "headers": {
          "accept": "*/*"
        },
        "body": ""
