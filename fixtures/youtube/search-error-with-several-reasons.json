{
  "service": "youtube",
  "action": "search",
  "case": "search-error-with-several-reasons",
  "env": {
    "YOUTUBE_API_KEY": "test-key"
  },
  "params": {
    "query": "x"
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://youtube.googleapis.com/youtube/v3/search?part=snippet&q=x&maxResults=10&key=test-key",
        "headers": {
          "accept": "*/*"
        },
        "body": ""
      },
      "response": {
        "status": 400,
        "body": "{\"error\":{\"code\":400,\"message\":\"ignored\",\"errors\":[{\"message\":\"first problem\"},{\"message\":\"second problem\"}]}}"
      }
    }
  ],
  "outcome": {
    "ok": false,
    "code": null,
    "message": "first problem\nsecond problem"
  }
}
