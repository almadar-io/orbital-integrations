{
  "service": "youtube",
  "action": "getChannel",
  "case": "get-channel-not-found-error",
  "env": {
    "YOUTUBE_API_KEY": "test-key"
  },
  "params": {
    "channelId": "gone"
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://youtube.googleapis.com/youtube/v3/channels?part=snippet&part=statistics&id=gone&key=test-key",
        "headers": {
          "accept": "*/*"
        },
        "body": ""
      },
      "response": {
        "status": 404,
        "body": "{\"error\":{\"code\":404,\"message\":\"The channel was not found.\",\"errors\":[{\"message\":\"The channel was not found.\",\"domain\":\"youtube.quota\",\"reason\":\"notFound\"}],\"status\":\"ERROR\"}}"
      }
    }
  ],
  "outcome": {
    "ok": false,
    "code": null,
    "message": "The channel was not found."
  }
}
