{
  "service": "youtube",
  "action": "getChannel",
  "case": "get-channel-hidden-subscribers",
  "env": {
    "YOUTUBE_API_KEY": "test-key"
  },
  "params": {
    "channelId": "chan2"
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://youtube.googleapis.com/youtube/v3/channels?part=snippet&part=statistics&id=chan2&key=test-key",
        "headers": {
          "accept": "*/*"
        },
        "body": ""
      },
      "response": {
        "status": 200,
        "body": "{\"items\":[{\"id\":\"chan2\",\"snippet\":{\"title\":\"Quiet\"},\"statistics\":{\"hiddenSubscriberCount\":true}}]}"
      }
    }
  ],
  "outcome": {
    "ok": true,
    "data": {
      "name": "Quiet"
    }
  }
}
