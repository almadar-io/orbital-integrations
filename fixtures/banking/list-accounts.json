{
  "service": "banking",
  "action": "listAccounts",
  "case": "list-accounts",
  "env": {
    "GOCARDLESS_SECRET_ID": "test-id",
    "GOCARDLESS_SECRET_KEY": "test-key"
  },
  "params": {
    "requisitionId": "req-1"
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://bankaccountdata.gocardless.com/api/v2/token/new/",
        "headers": {
          "content-type": "application/json",
          "accept": "application/json"
        },
        "body": "{\"secret_id\":\"test-id\",\"secret_key\":\"test-key\"}"
      },
      "response": {
        "status": 200,
        "body": "{\"access\":\"access-abc\",\"access_expires\":86400,\"refresh\":\"refresh-abc\",\"refresh_expires\":2592000}"
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://bankaccountdata.gocardless.com/api/v2/requisitions/req-1/",
        "headers": {
          "content-type": "application/json",
          "accept": "application/json",
          "authorization": "<redacted>"
        },
        "body": ""
      },
      "response": {
        "status": 200,
        "body": "{\"id\":\"req-1\",\"status\":\"LN\",\"accounts\":[\"acc-1\",\"acc-2\"]}"
      }
    }
  ],
  "outcome": {
    "ok": true,
    "data": {
      "accounts": [
        "acc-1",
        "acc-2"
      ]
    }
  }
}
