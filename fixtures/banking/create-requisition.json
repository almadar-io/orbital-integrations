{
  "service": "banking",
  "action": "createRequisition",
  "case": "create-requisition",
  "env": {
    "GOCARDLESS_SECRET_ID": "test-id",
    "GOCARDLESS_SECRET_KEY": "test-key"
  },
  "params": {
    "institutionId": "REVOLUT_REVOGB21",
    "redirectUrl": "https://app.example.com/bank/return"
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://bankaccountdata.gocardless.com/api/v2/token/new/",
        "headers": {
          "content-type": "application/json",
          "accept": "application/json"
        },
        "body": "{\"secret_id\":\"test-id\",\"secret_key\":\"test-key\"}"
      },
      "response": {
        "status": 200,
        "body": "{\"access\":\"access-abc\",\"access_expires\":86400,\"refresh\":\"refresh-abc\",\"refresh_expires\":2592000}"
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://bankaccountdata.gocardless.com/api/v2/requisitions/",
        "headers": {
          "content-type": "application/json",
          "accept": "application/json",
          "authorization": "<redacted>"
        },
        "body": "{\"institution_id\":\"REVOLUT_REVOGB21\",\"redirect\":\"https://app.example.com/bank/return\"}"
      },
      "response": {
        "status": 201,
        "body": "{\"id\":\"req-1\",\"link\":\"https://ob.gocardless.com/psd2/start/req-1/REVOLUT_REVOGB21\",\"status\":\"CR\"}"
      }
    }
  ],
  "outcome": {
    "ok": true,
    "data": {
      "requisitionId": "req-1",
      "link": "https://ob.gocardless.com/psd2/start/req-1/REVOLUT_REVOGB21"
    }
  }
}
