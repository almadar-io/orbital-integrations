{
  "service": "banking",
  "action": "createRequisition",
  "case": "create-requisition-empty-reply",
  "env": {
    "GOCARDLESS_SECRET_ID": "test-id",
    "GOCARDLESS_SECRET_KEY": "test-key"
  },
  "params": {
    "institutionId": "X",
    "redirectUrl": "https://app.example.com/r"
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://bankaccountdata.gocardless.com/api/v2/token/new/",
        "headers": {
          "content-type": "application/json",
          "accept": "application/json"
        },
        "body": "{\"secret_id\":\"test-id\",\"secret_key\":\"test-key\"}"
      },
      "response": {
        "status": 200,
        "body": "{\"access\":\"access-abc\",\"access_expires\":86400,\"refresh\":\"refresh-abc\",\"refresh_expires\":2592000}"
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://bankaccountdata.gocardless.com/api/v2/requisitions/",
        "headers": {
          "content-type": "application/json",
          "accept": "application/json",
          "authorization": "<redacted>"
        },
        "body": "{\"institution_id\":\"X\",\"redirect\":\"https://app.example.com/r\"}"
      },
      "response": {
        "status": 201,
        "body": "{}"
      }
    }
  ],
  "outcome": {
    "ok": true,
    "data": {
      "requisitionId": "",
      "link": ""
    }
  }
}
