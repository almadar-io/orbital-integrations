{
  "service": "banking",
  "action": "createRequisition",
  "case": "create-requisition-error-body-over-300-chars",
  "env": {
    "GOCARDLESS_SECRET_ID": "test-id",
    "GOCARDLESS_SECRET_KEY": "test-key"
  },
  "params": {
    "institutionId": "NOPE",
    "redirectUrl": "https://app.example.com/r"
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://bankaccountdata.gocardless.com/api/v2/token/new/",
        "headers": {
          "content-type": "application/json",
          "accept": "application/json"
        },
        "body": "{\"secret_id\":\"test-id\",\"secret_key\":\"test-key\"}"
      },
      "response": {
        "status": 200,
        "body": "{\"access\":\"access-abc\",\"access_expires\":86400,\"refresh\":\"refresh-abc\",\"refresh_expires\":2592000}"
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://bankaccountdata.gocardless.com/api/v2/requisitions/",
        "headers": {
          "content-type": "application/json",
          "accept": "application/json",
          "authorization": "<redacted>"
        },
        "body": "{\"institution_id\":\"NOPE\",\"redirect\":\"https://app.example.com/r\"}"
      },
      "response": {
        "status": 400,
        "body": "{\"detail\":\"\",\"status_code\":400}"
      }
    }
  ],
  "outcome": {
    "ok": false,
    "code": null,
    "message": "GoCardless error 400: {\"detail\":\"yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"
  }
}
