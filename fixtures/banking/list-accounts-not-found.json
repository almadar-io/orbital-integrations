{
  "service": "banking",
  "action": "listAccounts",
  "case": "list-accounts-not-found",
  "env": {
    "GOCARDLESS_SECRET_ID": "test-id",
    "GOCARDLESS_SECRET_KEY": "test-key"
  },
  "params": {
    "requisitionId": "missing"
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://bankaccountdata.gocardless.com/api/v2/token/new/",
        "headers": {
          "content-type": "application/json",
          "accept": "application/json"
        },
        "body": "{\"secret_id\":\"test-id\",\"secret_key\":\"test-key\"}"
      },
      "response": {
        "status": 200,
        "body": "{\"access\":\"access-abc\",\"access_expires\":86400,\"refresh\":\"refresh-abc\",\"refresh_expires\":2592000}"
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://bankaccountdata.gocardless.com/api/v2/requisitions/missing/",
        "headers": {
          "content-type": "application/json",
          "accept": "application/json",
          "authorization": "<redacted>"
        },
        "body": ""
      },
      "response": {
        "status": 404,
        "body": "{\"summary\":\"Not found.\",\"detail\":\"Not found.\",\"status_code\":404}"
      }
    }
  ],
  "outcome": {
    "ok": false,
    "code": null,
    "message": "GoCardless error 404: {\"summary\":\"Not found.\",\"detail\":\"Not found.\",\"status_code\":404}"
  }
}
