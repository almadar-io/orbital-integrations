{
  "service": "banking",
  "action": "listTransactions",
  "case": "list-transactions-rate-limited",
  "env": {
    "GOCARDLESS_SECRET_ID": "test-id",
    "GOCARDLESS_SECRET_KEY": "test-key"
  },
  "params": {
    "accountId": "acc-1"
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://bankaccountdata.gocardless.com/api/v2/token/new/",
        "headers": {
          "content-type": "application/json",
          "accept": "application/json"
        },
        "body": "{\"secret_id\":\"test-id\",\"secret_key\":\"test-key\"}"
      },
      "response": {
        "status": 200,
        "body": "{\"access\":\"access-abc\",\"access_expires\":86400,\"refresh\":\"refresh-abc\",\"refresh_expires\":2592000}"
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://bankaccountdata.gocardless.com/api/v2/accounts/acc-1/transactions/",
        "headers": {
          "content-type": "application/json",
          "accept": "application/json",
          "authorization": "<redacted>"
        },
        "body": ""
      },
      "response": {
        "status": 429,
        "body": "{\"summary\":\"Rate limit\",\"detail\":\"slow down\",\"status_code\":429}"
      }
    }
  ],
  "outcome": {
    "ok": false,
    "code": null,
    "message": "GoCardless error 429: {\"summary\":\"Rate limit\",\"detail\":\"slow down\",\"status_code\":429}"
  }
}
