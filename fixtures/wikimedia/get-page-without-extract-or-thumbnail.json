{
  "service": "wikimedia",
  "action": "getPage",
  "case": "get-page-without-extract-or-thumbnail",
  "env": {},
  "params": {
    "title": "Stub"
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://en.wikipedia.org/w/api.php?action=query&format=json&redirects=1&prop=pageimages|description|extracts&explaintext=1&exintro=1&piprop=thumbnail&pithumbsize=240&titles=Stub",
        "headers": {
          "accept": "*/*",
          "user-agent": "Almadar/1.0 (https://almadar.dev)"
        },
        "body": ""
      },
      "response": {
        "status": 200,
        "body": "{\"batchcomplete\":\"\",\"query\":{\"pages\":{\"2\":{\"pageid\":2,\"title\":\"Stub\",\"description\":\"A stub\"}}}}"
      }
    }
  ],
  "outcome": {
    "ok": true,
    "data": {
      "title": "Stub",
      "description": "A stub"
    }
  }
}
