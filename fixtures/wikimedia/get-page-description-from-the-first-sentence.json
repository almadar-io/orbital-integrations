{
  "service": "wikimedia",
  "action": "getPage",
  "case": "get-page-description-from-the-first-sentence",
  "env": {},
  "params": {
    "title": "Tea"
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://en.wikipedia.org/w/api.php?action=query&format=json&redirects=1&prop=pageimages|description|extracts&explaintext=1&exintro=1&piprop=thumbnail&pithumbsize=240&titles=Tea",
        "headers": {
          "accept": "*/*",
          "user-agent": "Almadar/1.0 (https://almadar.dev)"
        },
        "body": ""
      },
      "response": {
        "status": 200,
        "body": "{\"batchcomplete\":\"\",\"query\":{\"pages\":{\"1\":{\"pageid\":1,\"title\":\"Tea\",\"extract\":\"Tea is an aromatic beverage. It is prepared from leaves.\"}}}}"
      }
    }
  ],
  "outcome": {
    "ok": true,
    "data": {
      "title": "Tea",
      "description": "Tea is an aromatic beverage",
      "extract": "Tea is an aromatic beverage. It is prepared from leaves."
    }
  }
}
